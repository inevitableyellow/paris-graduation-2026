rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guests — readable by anyone with the code, writable only by signed-in admin
    match /guests/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    // Photos — anyone can read/create; only signed-in admin can delete
    match /photos/{photoId} {
      allow read: if true;
      allow create: if true;
      allow delete: if request.auth != null;
      allow update: if false;
    }

    // Notes — anyone can read/create; only signed-in admin can delete
    match /notes/{noteId} {
      allow read: if true;
      allow create: if true;
      allow delete: if request.auth != null;
      allow update: if false;
    }
  }
}
