rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Guests — readable by anyone with the code, writable only by signed-in admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "pmheard@umich.edu";
    }

    match /guests/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Photos — anyone can read/create; only admin can delete
    match /photos/{photoId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isAdmin();
      allow update: if false;
    }

    // Notes — anyone can read/create; only admin can delete
    match /notes/{noteId} {
      allow read: if true;
      allow create: if true;
      allow delete: if isAdmin();
      allow update: if false;
    }
  }
}
